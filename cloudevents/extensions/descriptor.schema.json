{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudEvents Descriptor",
  "anyOf": [
    { "$ref": "#/$defs/metadata" },
    { "$ref": "#/$defs/bundle" }
  ],
  "$defs": {
    "descriptor": {
      "type": "object",
      "required": ["entries"],
      "additionalProperties": true,
      "properties": {
        "bundleurl": { "$ref": "#/$defs/httpUrl" },
        "entries": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9:_.-]{0,62}(?![\\s\\S])" }
        }
      }
    },
    "absoluteUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^#\\s]+(?![\\s\\S])"
    },
    "httpUrl": {
      "$ref": "#/$defs/absoluteUri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:[^/?#@\\s]*@)?(?:\\[[^\\]\\s/?#]+\\]|[^\\[\\]:@/?#\\s]+)(?::[0-9]*)?(?=[/?]|(?![\\s\\S]))"
    },
    "entry": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": true,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "schemaEntry": {
      "$ref": "#/$defs/entry",
      "required": ["url"],
      "properties": {
        "class": { "const": "schema" }
      }
    },
    "endpointEntry": {
      "$ref": "#/$defs/entry",
      "required": ["url"],
      "properties": {
        "class": { "const": "endpoint" }
      }
    },
    "document": {
      "type": "object",
      "required": ["contenttype"],
      "properties": {
        "contenttype": { "type": "string", "minLength": 1 },
        "baseurl": { "$ref": "#/$defs/httpUrl" },
        "content": {},
        "contentbase64": {
          "type": "string",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        }
      },
      "oneOf": [{ "required": ["content"] }, { "required": ["contentbase64"] }]
    },
    "metadata": {
      "$ref": "#/$defs/descriptor",
      "properties": {
        "entries": {
          "additionalProperties": {
            "$ref": "#/$defs/entry",
            "properties": { "document": false }
          }
        }
      }
    },
    "bundle": {
      "$ref": "#/$defs/descriptor",
      "properties": {
        "entries": {
          "additionalProperties": {
            "$ref": "#/$defs/entry",
            "if": { "required": ["url"] },
            "then": {
              "required": ["document"],
              "properties": { "document": { "$ref": "#/$defs/document" } }
            },
            "else": { "properties": { "document": false } }
          }
        }
      }
    }
  }
}
